+@react.component
+let make = () => {
+  let {merchantId} = React.useContext(UserInfoProvider.defaultContext).getCommonSessionDetails()
+  let {userHasResourceAccess} = GroupACLHooks.useUserGroupACLHook()
+  let destinations: array<(string, string, UserManagementTypes.resourceAccessType)> = [
+    ("Payments", "/payments", Payment),
+    ("Refunds", "/refunds", Refund),
+    ("Customers", "/customers", Customer),
+    ("Payment analytics", "/analytics-payments", Analytics),
+  ]
+  <section dataTestId="collection-home" className="flex flex-col gap-5">
+    <h1 className="text-2xl font-semibold"> {"Your collections"->React.string} </h1>
+    <p className="text-nd_gray-500">
+      {`Manage payments and review activity for ${merchantId}. Payment channels are managed by your platform.`->React.string}
+    </p>
+    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
+      {destinations
+      ->Array.filter(((_, _, resource)) =>
+        userHasResourceAccess(~resourceAccess=resource) == CommonAuthTypes.Access
+      )
+      ->Array.map(((title, path, _)) =>
+        <button
+          key=path
+          className="border rounded-lg p-5 text-left font-semibold hover:bg-nd_gray-100"
+          onClick={_ => GlobalVars.appendDashboardPath(~url=path)->RescriptReactRouter.push}>
+          {title->React.string}
+        </button>
+      )
+      ->React.array}
+    </div>
+  </section>
+}
diff --git a/src/entryPoints/DashboardAccess.res b/src/entryPoints/DashboardAccess.res
new file mode 100644
index 0000000..856d2a0
--- /dev/null
+++ b/src/entryPoints/DashboardAccess.res
@@ -0,0 +1,33 @@
+// Presentation policy only. The API remains the authority for every operation.
+let isCollectionRole = roleId =>
+  roleId == "collection_merchant_admin" || roleId == "collection_merchant_view_only"
+
+let isPlatformRole = roleId => roleId == "tenant_admin" || roleId == "internal_admin"
+
+let isCollectionPath = path =>
+  switch path {
+  | list{}
+  | list{"v2", "home"}
+  | list{"home", ..._}
+  | list{"payments", ..._}
+  | list{"refunds", ..._}
+  | list{"disputes", ..._}
+  | list{"customers", ..._}
+  | list{"payment-links", ..._}
+  | list{"developer-api-keys", ..._}
+  | list{"webhooks", ..._}
+  | list{"users", ..._}
+  | list{"analytics-payments", ..._}
+  | list{"analytics-refunds", ..._}
+  | list{"analytics-disputes", ..._}
+  | list{"account-settings", "profile", ..._}
+  | list{"unauthorized"} => true
+  | _ => false
+  }
+
+let canVisit = (roleId, path) => {
+  switch path {
+  | list{"platform", ..._} => isPlatformRole(roleId)
+  | _ => !isCollectionRole(roleId) || isCollectionPath(path)
+  }
+}
